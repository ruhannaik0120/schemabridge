# Direct clean_mcp runtime template. The repository-root .env.example also
# includes Docker Compose and integration-test settings.
DB_TYPE=demo
DB_HOST=demo-local
DB_DATABASE=qa_demo
DB_USERNAME=
DB_PASSWORD=
DB_CONNECTION_OPTIONS={}
DB_TIMEOUT_SECONDS=30
DB_MAX_ROWS=500
DB_ACTIVE_PROFILE=demo-local
DB_PROFILES_JSON={"demo-local":{"db_type":"demo","database":"qa_demo"},"postgres-source":{"db_type":"postgresql","host":"<POSTGRES_HOST>","database":"<POSTGRES_DATABASE>","username":"<POSTGRES_USERNAME>","password":"<POSTGRES_PASSWORD>","connection_options":{"port":5432,"sslmode":"require"},"timeout_seconds":30,"max_rows":500,"write_enabled":false},"snowflake-target":{"db_type":"snowflake","host":"<SNOWFLAKE_ACCOUNT_IDENTIFIER>","database":"<SNOWFLAKE_DATABASE>","username":"<SNOWFLAKE_USERNAME>","password":"<SNOWFLAKE_PASSWORD>","connection_options":{"warehouse":"<SNOWFLAKE_WAREHOUSE>","schema":"<SNOWFLAKE_SCHEMA>","role":"<SNOWFLAKE_ROLE>"},"timeout_seconds":30,"max_rows":500,"write_enabled":false}}
SCHEMABRIDGE_CONTROL_PLANE_DSN=postgresql://<CONTROL_USER>:<CONTROL_PASSWORD>@localhost:5432/<CONTROL_DATABASE>
LOG_LEVEL=INFO
DB_SMOKE_TEST_CONNECT=false

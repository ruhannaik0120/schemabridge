# SchemaBridge local-only template. Copy to .env and replace placeholders locally.
# Never commit a populated .env file.

# Docker Compose ports and disposable control-plane PostgreSQL credentials.
SCHEMABRIDGE_API_PORT=8000
SCHEMABRIDGE_CONTROL_PLANE_PORT=55432
SCHEMABRIDGE_CONTROL_PLANE_DB=schemabridge
SCHEMABRIDGE_CONTROL_PLANE_USER=schemabridge
SCHEMABRIDGE_CONTROL_PLANE_PASSWORD=local_only_change_me

# Use this DSN when running the API or migration script directly on the host.
SCHEMABRIDGE_CONTROL_PLANE_DSN=postgresql://schemabridge:local_only_change_me@localhost:55432/schemabridge

# Legacy/offline connector defaults. These let the process start without real integrations.
DB_TYPE=demo
DB_HOST=demo-local
DB_DATABASE=schemabridge_demo
DB_USERNAME=
DB_PASSWORD=
DB_CONNECTION_OPTIONS={}
DB_TIMEOUT_SECONDS=30
DB_MAX_ROWS=500
LOG_LEVEL=INFO

# Named runtime profiles. Replace every angle-bracket placeholder before using
# PostgreSQL discovery or Snowflake execution. Keep write_enabled=false until a
# reviewer explicitly authorizes the target profile for migration writes.
DB_PROFILES_JSON={"demo-local":{"db_type":"demo","database":"schemabridge_demo"},"postgres-source":{"db_type":"postgresql","host":"<POSTGRES_HOST>","database":"<POSTGRES_DATABASE>","username":"<POSTGRES_USERNAME>","password":"<POSTGRES_PASSWORD>","connection_options":{"port":5432,"sslmode":"require"},"timeout_seconds":30,"max_rows":500,"write_enabled":false},"mysql-source":{"db_type":"mysql","host":"<MYSQL_HOST>","database":"<MYSQL_DATABASE>","username":"<MYSQL_USERNAME>","password":"<MYSQL_PASSWORD>","connection_options":{"port":3306},"timeout_seconds":30,"max_rows":500,"write_enabled":false},"snowflake-target":{"db_type":"snowflake","host":"<SNOWFLAKE_ACCOUNT_IDENTIFIER>","database":"<SNOWFLAKE_DATABASE>","username":"<SNOWFLAKE_USERNAME>","password":"<SNOWFLAKE_PASSWORD>","connection_options":{"warehouse":"<SNOWFLAKE_WAREHOUSE>","schema":"<SNOWFLAKE_SCHEMA>","role":"<SNOWFLAKE_ROLE>"},"timeout_seconds":30,"max_rows":500,"write_enabled":false}}

# Optional integration tests. Keep disabled for the normal credential-free suite.
SCHEMABRIDGE_RUN_CONTROL_PLANE_INTEGRATION=0
SCHEMABRIDGE_CONTROL_PLANE_TEST_DSN=postgresql://schemabridge:local_only_change_me@localhost:55432/schemabridge_test
SCHEMABRIDGE_POSTGRES_INTEGRATION=0
SCHEMABRIDGE_POSTGRES_HOST=<POSTGRES_TEST_HOST>
SCHEMABRIDGE_POSTGRES_PORT=5432
SCHEMABRIDGE_POSTGRES_DATABASE=<POSTGRES_TEST_DATABASE>
SCHEMABRIDGE_POSTGRES_USERNAME=<POSTGRES_TEST_USERNAME>
SCHEMABRIDGE_POSTGRES_PASSWORD=<POSTGRES_TEST_PASSWORD>
DB_SMOKE_TEST_CONNECT=false
